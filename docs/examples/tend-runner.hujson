// tend-runner configuration (HuJSON). Secrets are not here: set
// TEND_HOST_TOKEN and, for the first start on the tailnet, TS_AUTHKEY,
// through an env file.
{
  "server_url": "http://tend",
  "host_id": "linux-1",
  // TEND_HOME: repos/, workspaces/, scratch/ and runner/ live here.
  "home": "~/.tend",
  "tailnet": {"hostname": "tend-runner-linux-1"},

  // Workers use this machine's traex and its own configuration. kind must
  // be the worker the server configures for this host.
  "worker": {"kind": "appserver", "traex_bin": "traex"},
  // Or an agent TUI in this machine's orca: agent is codex or traex, and
  // each repository names its orca registration below. model and effort
  // optionally override the agent's defaults; orca takes effort only with
  // a model.
  // "worker": {"kind": "orca", "agent": "codex"},
  // Independent acceptance defaults (omit to inherit worker model/effort):
  // "worker": {"kind": "orca", "agent": "traex", "acceptance": {"model": "GPT-6.1-Sol", "effort": "xhigh"}},

  "repos": {
    "tend": {
      // An existing clone to borrow objects from on the first clone.
      // "reference": "~/src/tend",
      // With the orca worker: the repository as registered in orca.
      // "orca": "name:tend",
      "profiles": {
        // A prepare step a mount can select, rerun when its inputs change.
        "deps": {"commands": [["go", "mod", "download"]], "rerun_if_changed": ["go.sum"], "timeout": "10m"},
      },
    },
  },
  // Workspace-level prepare steps, run after every mount is prepared.
  "profiles": {},
}
