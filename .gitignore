# Secrets never live in the repo; dev auth keys go in ~/.config/tend/dev.env.
# Machine-specific notes and config (hosts, paths, accounts) stay local.
/.local/

*.env
.env*

/bin/
/tend-server
/tend-runner
/dist/
node_modules/
*.sqlite
*.sqlite-*

# Spike outputs
spikes/**/out/

# Web client build output (make web)
/internal/webui/dist/app/

# pnpm store, which pnpm puts at the root of the mount it runs in
/.pnpm-store/
