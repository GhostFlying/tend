{
  "name": "tend",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "HTTP_PROXY": "${localEnv:HTTP_PROXY}",
      "HTTPS_PROXY": "${localEnv:HTTPS_PROXY}",
      "NO_PROXY": "${localEnv:NO_PROXY}",
      "http_proxy": "${localEnv:http_proxy}",
      "https_proxy": "${localEnv:https_proxy}",
      "no_proxy": "${localEnv:no_proxy}"
    }
  },
  "// paths": "traex records absolute paths in its state db; keep the dedicated TRAE_HOME and the workspace at their host paths.",
  "workspaceMount": "source=${localWorkspaceFolder},target=${localWorkspaceFolder},type=bind",
  "workspaceFolder": "${localWorkspaceFolder}",
  "remoteUser": "dev",
  "updateRemoteUserUID": true,
  "runArgs": [
    "--env-file", "${localEnv:HOME}/.config/tend/dev.env",
    "--security-opt", "seccomp=unconfined"
  ],
  "containerEnv": {
    "HTTP_PROXY": "${localEnv:HTTP_PROXY}",
    "HTTPS_PROXY": "${localEnv:HTTPS_PROXY}",
    "NO_PROXY": "${localEnv:NO_PROXY}",
    "http_proxy": "${localEnv:http_proxy}",
    "https_proxy": "${localEnv:https_proxy}",
    "no_proxy": "${localEnv:no_proxy}",
    "TEND_DATA_DIR": "/home/dev/.local/share/tend",
    "TEND_TS_HOSTNAME": "tend-dev",
    "TRAE_HOME": "${localEnv:HOME}/.local/share/tend/traex-home",
    "TEND_TRAEX_MODEL": "GPT-5.6-Sol"
  },
  "mounts": [
    "source=${localEnv:HOME}/.local/share/traex,target=/opt/traex,type=bind,readonly",
    "source=${localEnv:HOME}/.local/share/tend/traex-home,target=${localEnv:HOME}/.local/share/tend/traex-home,type=bind",
    "source=${localEnv:HOME}/.ssh,target=/home/dev/.ssh-host,type=bind,readonly",
    "source=tend-go-mod,target=/go/pkg/mod,type=volume",
    "source=tend-data,target=/home/dev/.local/share/tend,type=volume"
  ],
  "postStartCommand": "bash .devcontainer/post-start.sh",
  "postCreateCommand": "go version && node --version && pnpm --version && traex --version",
  "customizations": {
    "vscode": {
      "extensions": ["golang.go", "dbaeumer.vscode-eslint"]
    }
  }
}
